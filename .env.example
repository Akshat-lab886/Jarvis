# --- Jarvis configuration (copy to .env and fill in) ---

# --- LLM (required: at least one of these) ---
# BRING YOUR OWN KEY — Jarvis runs on ANY combination of providers below.
# Keys are tried in JARVIS_PROVIDER_ORDER (default: google, groq, anthropic,
# openai, deepseek, openrouter, custom, ollama, lmstudio) with automatic
# failover, cooldowns and capability-aware routing (vision/tools).
#
# Groq API key (https://console.groq.com)
GROQ_API_KEY=
# Optional: comma-separated Groq model slugs, tried in order.
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,groq/compound-mini

# Google Gemini (https://aistudio.google.com/apikey)
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini,gpt-4o

# Anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODELS=claude-sonnet-4-5,claude-3-5-haiku-latest

# DeepSeek (https://platform.deepseek.com)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# Vyce — primary provider (DeepSeek v4.1 via https://vyceai.com/v1).
# OpenAI-compatible endpoint; the SDK auto-appends /chat/completions so
# VYCE_BASE_URL must be the API ROOT only. Vyce is tried FIRST in the
# default provider order. No key shipped — set yours here.
# VYCE_API_KEY=
# VYCE_BASE_URL=https://vyceai.com/v1
# VYCE_MODEL=deepseek-v4.1
# VYCE_TIMEOUT_S=120

# OpenRouter (https://openrouter.ai/keys) — 400+ models behind one key
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openrouter/auto

# Local models (zero cost, private) — no key needed, auto-detected
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Opt out of local probing entirely (boot skips Ollama/LM Studio
# checks). Set either URL to off/none/disabled to skip just that one.
# JARVIS_DISABLE_LOCAL=0

# Any other OpenAI-compatible endpoint (vLLM, Together, Mistral, llama.cpp...)
# CUSTOM_OPENAI_BASE_URL=
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_MODELS=

# Provider priority override + prefer local models first
# JARVIS_PROVIDER_ORDER=google,groq,anthropic,openai
# JARVIS_PREFER_LOCAL=1

# --- Web dashboard ---
# SECRET_KEY=mysecret
# PORT=5001
# DEBUG=True
# HTTPS=False  (set True to serve with a persistent self-signed cert)

# --- Telegram remote control (optional) ---
# TELEGRAM_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control Jarvis.
# Empty = locked down (all remote commands denied).
# TELEGRAM_ALLOWED_IDS=

# --- Google email/calendar (optional) ---
# Uses client_secret.json (see auth.py) + token.json. Also:
# GMAIL_USER=
# GMAIL_PASSWORD=

# --- GitHub publish (optional) ---
# GITHUB_TOKEN=
# GITHUB_USERNAME=

# --- Tuning ---
# REMINDER_POLL_INTERVAL=10
# DESKTOP_AGENT_MAX_STEPS=8
# UPLOAD_PROTECTION_SECONDS=300

# --- Agent core (Phase 2) ---
# Native tool-calling loop: 'auto' (default) engages when the fleet has
# tool-capable models; 'on' forces it; 'off' = legacy JSON routing only.
# JARVIS_AGENT_MODE=auto
# Max tool iterations per request (default 10)
# JARVIS_AGENT_MAX_STEPS=10
# Stream final answers token-by-token to the dashboard (1/0)
# JARVIS_AGENT_STREAM=1
# Pin the agent brain, e.g. "groq:openai/gpt-oss-120b" (strongest model
# for multi-step reasoning while chat stays on cheap defaults)
# JARVIS_AGENT_MODEL=

# --- MCP tool servers (Phase 3) ---
# Copy config/mcp_servers.example.json -> config/mcp_servers.json and list
# any Model-Context-Protocol servers (npx/uvx/python). Their tools join the
# agent fleet automatically as mcp__<server>__<tool>.
# JARVIS_MCP_START_TIMEOUT=15
# JARVIS_MCP_CALL_TIMEOUT=30

# --- Agent reasoning layer ---
# Extra knobs for the reasoning-first agent loop (beyond AGENT_MODE above).
# Independent tool calls of one turn run concurrently (0 forces sequential)
# JARVIS_AGENT_PARALLEL=1
# Chars of tool output fed back to the model per step
# JARVIS_AGENT_TOOL_CAP=4000
# Planner draft injected for complex prompts (0 disables)
# JARVIS_AGENT_PLAN=1
# Critic re-checks the final answer after real tool work (0 disables)
# JARVIS_AGENT_VERIFY=1
# 'deep' intensifies thinking, raises the step budget, forces verification
# JARVIS_REASON_EFFORT=normal
# Cap the tool fleet offered to the model (curated core never dropped;
# MCP extras trimmed first, any_action escape hatch kept last)
# JARVIS_AGENT_MAX_TOOLS=64
# Persistent agent task plan file (0 = in-memory only, no disk writes)
# JARVIS_AGENT_PLAN_STORE=1

# --- RLM: recursive memory hierarchy ---
# Master switch — 0 disables the whole memory subsystem
# JARVIS_RLM=1
# Override the store paths (multi-tenant / test isolation)
# JARVIS_RLM_DATA_FILE=brain/data/rlm_memory.json
# JARVIS_AGENT_PLAN_FILE=brain/data/agent_plan.json
# Consolidation batches: events per L1 summary, sessions per L2 fold
# JARVIS_RLM_L0_BATCH=12
# JARVIS_RLM_L1_BATCH=6
# Hours before the world model is re-distilled
# JARVIS_RLM_WORLD_TTL_H=12
# Reflect (extract insights) every N consolidation passes
# JARVIS_RLM_REFLECT_EVERY=3
# Prompt-budget caps for the recall block and recall_deep tool
# JARVIS_RLM_MAX_CHARS=1400
# JARVIS_RLM_DEEP_CHARS=2200
# Bounded L0 event log + background "sleep" tick (seconds)
# JARVIS_RLM_MAX_L0=400
# JARVIS_RLM_TICK_S=300

# --- RLM: PrimeAgent-level memory (temporal + entity + continuity) ---
# Entity graph layer (subject queries, co-occurrence edges). 0 = off.
# JARVIS_RLM_ENTITIES=1
# Max distinct subjects tracked (lowest-count evicted first)
# JARVIS_RLM_ENTITY_MAX=500
# Recency-decay horizon in days. Bigger = memories stay "fresh" longer;
# the scoring floor keeps durable knowledge from ever vanishing.
# JARVIS_RLM_DECAY_DAYS=21
# Idle seconds after which the next turn counts as a NEW session and
# re-injects where the last one left off (1800s = half an hour)
# JARVIS_RLM_CONTINUITY_GAP_S=1800
# Retrieval score = relevance^W_REL x recency^W_REC x importance^W_IMP.
# Raise W_REC to favour recent events, W_IMP for durable knowledge.
# JARVIS_RLM_W_REL=1.0
# JARVIS_RLM_W_REC=0.5
# JARVIS_RLM_W_IMP=0.5

# --- Autonomy: goals, background work, proactive voice ---
# Tracked objectives with deadlines ("do X by Friday") + watchdog
# escalation + opt-in autostart of planned background tasks (0 = off)
# JARVIS_GOALS=1
# Let goals spawn their own planned tasks without being asked (0 =
# suggest-only; 1 = full autonomy for the planning step — execution
# still passes through approvals below)
# JARVIS_GOALS_AUTOSTART=0
# Hours before a deadline that a goal escalates (and watchdog cadence)
# JARVIS_GOALS_ESCALATE_H=24
# JARVIS_GOALS_TICK_S=600
# Proactive announcements: dashboard feed always; voice/Telegram opt-in
# (high priority only reaches Telegram). Rate-limited per hour.
# JARVIS_NOTIFY=1
# JARVIS_NOTIFY_VOICE=0
# JARVIS_NOTIFY_TELEGRAM=0
# JARVIS_NOTIFY_MAX_PER_H=6
# Background proactive scan narration (schedule clashes, urgent mail —
# dashboard + notifier channels, deduped daily). 0 = scan only when
# asked (morning briefing still works).
# JARVIS_PROACTIVE_NARRATE=0
# Approvals: off | critical (default) | strict. critical = destructive
# actions hold for a human, trusted background origins (goals watchdog,
# recurring, proactive) self-approve the narrow AUTO_APPROVABLE set.
# strict = EVERYTHING holds, no exceptions — full oversight mode.
# JARVIS_APPROVALS=critical
# Seconds a held action waits for your yes (dashboard approval card)
# APPROVAL_TIMEOUT_S=120

# --- Capability awareness ---
# Pre-task capability assessment (0 = skip, everything treated as available)
# JARVIS_CAPABILITY_CHECK=1
# Seconds a readiness probe stays cached (socket/HTTP checks are expensive)
# JARVIS_CAP_TTL_S=120
# Auto-install pip packages when capabilities are missing (0 = off, 1 = on).
# When on, pure-pip gaps (web_search, knowledge_vault, remote_access, git_ops,
# meeting_notes) install silently at the capability pre-flight so features just
# work.  Capabilities needing OAuth/accessibility-permissions/manual commands
# (email, calendar, desktop_control, browser) still require manual setup.
# JARVIS_AUTO_UPGRADE=1
# Session spend guard: estimated USD + total-token hard caps per process
# (budget guard trips politely instead of burning quota in a loop)
# JARVIS_BUDGET_USD=5
# JARVIS_BUDGET_TOKENS=500000
# Warn once past this % of either cap
# JARVIS_WARN_AT_PCT=80
# Procedural self-learning: distill lessons + auto-forge skills (0 = off)
# JARVIS_AUTO_LEARN=1

# --- Bounded learning loop ---
# USER.md / MEMORY.md / .jarvis.md self-updating guardrails (0 = off)
# JARVIS_GUARDRAILS=1
# Project dir whose .jarvis.md holds boundaries for the active workspace
# JARVIS_PROJECT_DIR=
# @marker context injection (files, dirs, @git, URLs) in any interface
# JARVIS_CONTEXT_INJECTION=1
# Skill forge: workflow telemetry -> SKILL.md creation -> self-patching
# JARVIS_SKILL_FORGE=1
# Background maintenance pass interval (seconds)
# JARVIS_SKILL_FORGE_TICK=900

# --- Execution environments ---
# Multi-backend runtime layer (0 = local only)
# JARVIS_RUNTIMES=1
# Image used for sandboxed docker code runs
# JARVIS_SANDBOX_IMAGE=python:3.11-slim
# Remote shell backend (BatchMode, key auth)
# JARVIS_SSH_HOST=
# JARVIS_SSH_USER=
# JARVIS_SSH_PORT=22
# Daytona sandbox workspace name
# JARVIS_DAYTONA_WS=default
# Apptainer/Singularity image
# JARVIS_SINGULARITY_IMAGE=docker://python:3.11-slim
# Modal entrypoint module for serverless runs
# JARVIS_MODAL_ENTRY=
# Persistent sandboxed Python RPC worker (0 = one-shot Coder engine)
# JARVIS_PYTHON_RPC=1
# Pre-edit workspace snapshots for /rollback (0 = off)
# JARVIS_CHECKPOINTS=1
# Post-edit syntax/LSP diagnostics (0 = off)
# JARVIS_LSP_DIAGNOSTICS=1
# Tier-2 checker template; {file} is substituted. Wins over the built-in
# tier-1 checkers when the binary exists. E.g. "pylsp --check {file}"
# JARVIS_LSP_CMD=
# Background desktop driver (AX clicks/typing) (0 = off)
# JARVIS_COMPUTER_USE=1

# --- Jev (TypeSafe System One) — fast typed decision gate for computer use ---
# Sub-second safety layer in front of desktop control: fast-denies
# prompt-injection payloads before the approval queue, attaches a
# calibrated risk score to every computer-use approval, and screens each
# step of the autonomous desktop_task loop for off-task drift / hazards.
# Text-only — it never picks click coordinates (the vision LLM keeps that).
# Fail-open: no key or any error => runs exactly as without it.
# Get a key (early access): https://console.typesafe.ai
# TYPESAFE_API_KEY=
# Master switch (0 = off)
# JARVIS_JEV=1
# Model alias — pin a version (e.g. jev-1.13.0) when thresholds matter
# JEV_MODEL=jev-latest
# Per-request timeout in seconds (Jev answers in 70–500ms)
# JEV_TIMEOUT_S=2.0
# Injection probability >= this fast-denies the approval (0.0–1.0)
# JEV_INJECT_DENY=0.85
# Desktop step on-task probability <  this skips the step (0.0–1.0).
# Only content-bearing (type/key) steps are screened — bare clicks pass.
# JEV_ON_TASK_MIN=0.15
# Desktop step hazard probability >= this aborts the loop (0.0–1.0)
# JEV_HAZARD_ABORT=0.90

# --- Omnichannel gateways + bot mode ---
# Gateway hub master switch (0 = no adapters)
# JARVIS_GATEWAYS=1
# Discord poll interval (seconds)
# JARVIS_GATEWAY_POLL=3
# Specialist routing of @jarvis mentions in group chats (0 = off)
# JARVIS_BOT_MODE=1
# Discord bot (plain REST — no discord.py needed)
# JARVIS_DISCORD_TOKEN=
# JARVIS_DISCORD_CHANNEL=
# User id that counts as a mention (<@ID> or the word 'jarvis')
# JARVIS_DISCORD_USER_ID=
# Slack: outgoing webhook URL + inbound Events API verify token/channel
# JARVIS_SLACK_WEBHOOK_URL=
# JARVIS_SLACK_VERIFY_TOKEN=
# JARVIS_SLACK_CHANNEL=
# Shared secret for POST /webhook
# JARVIS_WEBHOOK_KEY=

# --- Mobile Link (paired phone PWA, Phase 0 remote + Phase 1 hub) ---
# Serve other devices on your LAN: JARVIS_HOST=0.0.0.0 (default is
# loopback-only).  Prefer Tailscale / Cloudflare Tunnel (both free)
# over a raw internet port-forward.
# JARVIS_HOST=127.0.0.1
# REQUIRED before any off-loopback phone/dashboard use: without it all
# dashboard-only routes (pair/list/revoke/handoff export) 403 off-loopback.
# JARVIS_WEBHOOK_KEY=
# Extra origins allowed to open the dashboard socket (comma-separated)
# JARVIS_ALLOWED_ORIGINS=
# Pairing-code lifetime (seconds, single-use)
# JARVIS_PAIR_TTL_S=600
# Phone-auth failures per IP before 429 (per 5-min window)
# JARVIS_MOBILE_RATE_FAILS=10
# Override where mobile_devices.json + mobile_events.jsonl live
# JARVIS_MOBILE_DATA_DIR=

# --- Jarvis AS an MCP server (memory export to other agents) ---
# 0 = serve() exits immediately (for hosts that auto-spawn it)
# JARVIS_MCP_SERVER=1
# Expose jarvis_ask (full think->execute pipeline with real side effects
# over MCP). Off by default — it is a remote-control door.
# JARVIS_MCP_EXPOSE_ASK=0

# --- Mixture of Agents ---
# MoA panel: same prompt to N providers, synthesizer persona merges
# JARVIS_MOA=1
# Panel size (2-5)
# JARVIS_MOA_N=3

# --- Browser / tool gateway ---
# Browser automation tier (0 = off)
# JARVIS_BROWSER_USE=1
# External tool gateway (browse/scrape/tts/image APIs)
# JARVIS_TOOL_GATEWAY=1
# JARVIS_TOOL_GATEWAY_URL=
# JARVIS_TOOL_GATEWAY_KEY=

# --- Voice ---
# Wake-word gating is OPT-IN: only "…jarvis…" utterances reach the brain
# JARVIS_WAKE_WORD_ENABLE=0
# JARVIS_WAKE_WORD=jarvis

# --- Media / UI ---
# Hyperframe: instructions -> storyboard -> HTML mockup (+video) (0 = off)
# JARVIS_HYPERFRAME=1
# Floating HUD window (pynput hotkey, tkinter)
# JARVIS_HUD=0
#
# --- Public / free APIs (most need NO key) ---
# Jarvis ships a fleet of free public-API integrations in utils/ext_api.py.
# They are usable as agent tools and as dashboard "intel strip" cells.
# All degrade gracefully: a down endpoint returns "unavailable" rather than
# crashing a session.
#
# weather(lat,lon)        Open-Meteo — current + N-day forecast, no key
# define(word)            Free Dictionary API — definitions + phonetics, no key
# scripture(ref)          bible-api.com — full-text verse lookup, no key
# ip_locate(ip?)          ipapi.co — IP geolocation (fair-use ~1k/day), no key
# earthquakes(..)         USGS — recent quakes near a point, no key
# joke()                  chucknorris.io — random facts, no key
# recipe(query)           The Meal DB — recipe search, no key
# cocktail(query)         The Cocktail DB — drink recipes, no key
# cat_fact()              catfact.ninja — random cat fact, no key
# dog_pic()               Dog CEO — random dog image URL, no key
# quote(tag?)             Quotable — random / tagged quotes, no key
# open_papers(query)      Core/OpenAlex — open-access papers (no key)
# research_papers(query)  OpenAlex — paper search (no key)
# spot_price(symbols)     Crypto via CoinGecko (no key). Stocks/forex via
#                         FMP — needs the free FMP_API_KEY below.
#
# No env vars required for any of the above. Keys already covered:
# ETHERSCAN_API_KEY, OCR_API_KEY, PDFLAYER_API_KEY, PIXELA_USER (optional).
#
# --- Tier A free-API key (optional, for stock/forex spot prices only) ---
# FMP_API_KEY = ""   # financialmodelingprep.com — free 250 calls/day tier
#   (crypto tickers like BTC-USD work without this key; only stocks/forex
#    such as AAPL, EURUSD need it. Yahoo Finance's free endpoint is 429-gated.)
